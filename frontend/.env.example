# 이 파일을 복사해 .env.local을 만들고 값을 채웁니다. (.env.local은 커밋되지 않습니다)
#   cp .env.example .env.local
# 값을 바꾼 뒤에는 npm run dev를 다시 시작해야 합니다.

# 구글 소셜 로그인 클라이언트 ID. 팀에서 따로 전달받으세요. 비워 두면 로그인 화면에 구글 버튼이 보이지 않습니다.
# 설정 방법: docs/social-login-setup.md
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# 백엔드 API 주소 (기본값: http://localhost:8080/api)
# NEXT_PUBLIC_API_URL=http://localhost:8080/api
